# =============================================================================
# Geo-Explorer — variáveis de ambiente do Docker
#
# Copie para um arquivo .env (não versionado) e ajuste os valores:
#   cp .env.example .env
# O compose.yaml lê este arquivo automaticamente.
# =============================================================================

# Portas expostas no host (as portas internas dos containers são fixas)
FRONTEND_PORT=5173
BACKEND_PORT=8080
FRONTEND_PROD_PORT=8088

# UID/GID do seu usuário no host — evita que artefatos gerados pelo Maven
# dentro do container (./target) fiquem pertencentes a root no diretório
# do projeto. Descubra os seus com: id -u  e  id -g
UID=1000
GID=1000

# Fuso horário dos containers
TZ=America/Sao_Paulo
